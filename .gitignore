# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.venv/
*.egg-info/

# PyRel runtime caches (regenerated on demand). Keep orchestrator evidence.
build/*
!build/task_reports/
!build/task_reports/*.json
!build/task_reports/.gitkeep
# Design briefs and live probe results are engineering evidence the next session inherits,
# not regenerable cache: PROBE_RESULTS.md cost a 631-second cold engine start to produce.
!build/design/
!build/design/*.md
rai_code/manual/build/

# Editor / OS
.DS_Store
.idea/
.vscode/
*.swp

# Secrets / local env
.env
.env.*.local

# Jupyter
.ipynb_checkpoints/
*.executed.ipynb

# Claude Code local overrides
.claude/settings.local.json
.claude/scheduled_tasks.lock

# Demo-day artifacts that should be regenerated, not committed
query_results/
*.log

# Design and reasoning record consumed by later sessions (large generated dumps stay ignored)
!build/design/
build/design/*
!build/design/*.md
